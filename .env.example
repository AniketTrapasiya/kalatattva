# ── SMTP for the contact form ─────────────────────────────────
# Copy this file to `.env.local` and fill in the real values.
# For Gmail: host smtp.gmail.com, port 465, and use an App Password
# (Google Account → Security → 2-Step Verification → App passwords).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Where enquiries should arrive (defaults to SMTP_USER if empty)
CONTACT_TO_EMAIL=your-email@gmail.com

# ── Site ──────────────────────────────────────────────────────
# The real production domain (used for SEO metadata, sitemap, schema).
# Leave unset on Vercel — the deployment's own domain is used until a
# custom domain exists.
NEXT_PUBLIC_SITE_URL=

# Search-console verification codes (optional, add when registering)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
